[Unit]
Description=Traveler SSH-only profile panel
After=traveler-origin.service

[Service]
ExecStart=/usr/bin/python3 /opt/traveler-panel/panel.py
RuntimeDirectory=traveler-panel
RuntimeDirectoryMode=0700
StateDirectory=traveler-panel
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/traveler-origin
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
