# Справочный пример .env, создаваемого установщиком.
# Для первой установки используйте переменные окружения (см. README),
# не создавайте .env заранее: его наличие означает существующую установку.
# Для восстановления заполните значениями именно своего сервера/бэкапа.
# SERVER_IP=1.2.3.4
# BIND_IP=1.2.3.4
# INIT_USERNAME=admin
# INIT_PASSWORD=ваш_существующий_пароль
# INIT_DNS=1.1.1.1,8.8.8.8
# WG_PORT=443
# WG_MTU=1280
