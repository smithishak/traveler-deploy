# Необязательно: deploy.sh сам создаёт .env (определяет IP, генерирует пароль).
# Этот файл — для ручного переопределения. Скопируй в .env и заполни.
#
# SERVER_IP=1.2.3.4
# BIND_IP=1.2.3.4  # IP сетевого интерфейса для привязки порта 53/udp (deploy.sh ставит сам;
#                  # если пусто — 53 повесится на 0.0.0.0 и может конфликтовать с systemd-resolved)
# INIT_USERNAME=admin
# INIT_PASSWORD=задай_длинный_пароль
# INIT_DNS=1.1.1.1,8.8.8.8
# WG_PORT=443      # основной UDP-порт (маскировка под QUIC); запасные 4500 и 53 добавляются всегда
